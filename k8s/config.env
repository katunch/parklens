# Non-secret API settings (docs/ARCHITECTURE.md §3). Secret values live in the parklens-env Secret, see README.md.
APP_TIMEZONE=Europe/Zurich
PUBLIC_APP_URL=https://parklens.dora.cust.sobr-brews.ch
ADMIN_EMAIL=admin@parklens.local
ADMIN_NAME=Parking Admin
# Set to true before the first start for a demo lot with generated traffic (runs once)
SEED_DEMO_DATA=false
WEBHOOK_FORMAT=generic
LOT_CAPACITY=40
# Load balancer + nginx in front of the API
TRUST_PROXY_HOPS=2
