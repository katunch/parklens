# Copy to .env to override defaults. Every value has a sensible default in docker-compose.yml,
# so `docker compose up -d` works without a .env file.

WEB_PORT=8088

POSTGRES_DB=parklens
POSTGRES_USER=parklens
POSTGRES_PASSWORD=parklens

# CHANGE THESE in any non-local environment
JWT_SECRET=change-me-in-production
GATE_API_KEY=dev-gate-key
ADMIN_EMAIL=admin@parklens.local
ADMIN_PASSWORD=parklens-admin
ADMIN_NAME=Parking Admin

APP_TIMEZONE=Europe/Zurich
PUBLIC_APP_URL=http://localhost:8088
SEED_DEMO_DATA=true

# Optional initial alarm webhook (can be changed in Admin → Settings)
WEBHOOK_URL=
# generic | slack | teams
WEBHOOK_FORMAT=generic

# Number of parking spaces shown on the command center (can be changed in Admin → Settings)
LOT_CAPACITY=40
